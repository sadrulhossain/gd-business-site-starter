# Copy to .env (make up does this automatically). Secrets here are dev-only values.
COMPOSE_PROJECT_NAME=gdsite
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
NODE_VERSION=24.22.3
NODE_DEBIAN_SUFFIX=trixie-slim
MONGO_VERSION=8.0.38
MAILPIT_VERSION=v1.33.1
NEXT_VERSION=16.4.6
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (28xxx block), all bound to 127.0.0.1.
MONGO_PORT=28017
MAILPIT_SMTP_PORT=28025
MAILPIT_UI_PORT=28026
PORTAL_DEV_PORT=28300
ADMIN_DEV_PORT=28301
API_DEV_PORT=28302

MONGODB_DB=gdsite

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

# Public origin of the portal (canonical URLs, Open Graph, sitemap).
SITE_URL=http://localhost:28300

# Auth (dev-only values; production secrets are set with `wrangler secret put`, see docs/ENV.md)
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef0123
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-0123456789abcdef01
COOKIE_NAME=rt
SITE_ORIGIN=http://localhost:28302

# Media (M3): images are committed to this repository through the GitHub API; without a token uploads return 503
UPLOADS_MAX_MB=5
MEDIA_MAX_FILES=6000
MEDIA_BASE_PATH=/media
MEDIA_GIT_BRANCH=main
GITHUB_REPO=
GITHUB_REPO_TOKEN=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Seed only: pnpm --filter @gd/api seed (the superadmin is created when both are set)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
