# Copy to .env (make up does this automatically). Secrets here are dev-only values.
COMPOSE_PROJECT_NAME=gdsite
COMPOSE_PROFILES=dev
APP_ENV=local
APP_DEBUG=true

# Pins (source of truth: docs/VERSIONS.md; checked by `make versions`)
NODE_VERSION=24.22.3
NODE_DEBIAN_SUFFIX=trixie-slim
MONGO_VERSION=8.0.38
MAILPIT_VERSION=v1.33.1
NEXT_VERSION=16.4.6
VITE_VERSION=8.3.8
REACT_VERSION=19.3.1

# Ports (28xxx block), all bound to 127.0.0.1.
MONGO_PORT=28017
MAILPIT_SMTP_PORT=28025
MAILPIT_UI_PORT=28026
PORTAL_DEV_PORT=28300
ADMIN_DEV_PORT=28301
API_DEV_PORT=28302

MONGODB_DB=gdsite

LOCALE_DEFAULT=en
LOCALE_FALLBACK=en
LOCALE_SUPPORTED=en

# Public origin of the portal (canonical URLs, Open Graph, sitemap).
SITE_URL=http://localhost:28300
