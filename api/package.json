{
  "name": "@gd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port ${API_DEV_PORT:-28302}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:deploy": "wrangler deploy -c spikes/wrangler.jsonc",
    "deploy:dry": "wrangler deploy --dry-run --outdir .wrangler/dry",
    "seed": "node src/seed/run.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "hash-wasm": "4.13.0",
    "mongoose": "9.12.2",
    "jose": "6.2.17"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@cloudflare/workers-types": "5.20261117.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.1",
    "sanitize-html": "2.18.2",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "wrangler": "4.164.0",
    "zod": "4.6.7"
  }
}
