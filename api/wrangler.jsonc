{
  "name": "gd-business-site",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["*/15 * * * *", "17 3 * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "MONGODB_DB": "gd-business-site-starter",
    "CORS_ALLOWED_ORIGINS": "",
    "LOCALE_DEFAULT": "en",
    "LOCALE_FALLBACK": "en",
    "LOCALE_SUPPORTED": "en",
    "UPLOADS_MAX_MB": "5",
    "MEDIA_MAX_FILES": "6000",
    "MEDIA_BASE_PATH": "/media",
    "MEDIA_GIT_BRANCH": "main",
    "MAIL_PROVIDER": "none",
    "GITHUB_WORKFLOW_FILE": "deploy.yml",
    "GITHUB_REF": "main",
    "PUBLISH_DEBOUNCE_MINUTES": "5"
  }
}
